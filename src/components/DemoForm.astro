---
import { SITE, waLink, telLink } from "../config/site";
---
<form class="df" id="demoForm" novalidate data-webhook={SITE.leadEndpoint} data-fallback={SITE.leadWebhookUrl} data-wa={SITE.whatsapp}>
  <div class="df__row">
    <label>Your name
      <input type="text" name="name" required autocomplete="name" placeholder="e.g. Ankur Kaplesh" />
    </label>
    <label>Company / firm
      <input type="text" name="company" required placeholder="e.g. ABC Contractors" />
    </label>
  </div>
  <div class="df__row">
    <label>Phone / WhatsApp
      <input type="tel" name="phone" required inputmode="tel" autocomplete="tel" placeholder="10-digit mobile" />
    </label>
    <label>City
      <input type="text" name="city" placeholder="e.g. Ludhiana" />
    </label>
  </div>
  <label>What kind of EPC work do you do?
    <select name="trade">
      <option value="">Select…</option>
      <option>MEP / HVAC / Electrical / Plumbing / Fire EPC</option>
      <option>Solar EPC</option>
      <option>Civil / Infrastructure EPC</option>
      <option>Industrial / Process EPC</option>
      <option>Turnkey / Multi-discipline EPC</option>
    </select>
  </label>
  <label>Team size
    <select name="team">
      <option value="">Select…</option>
      <option>1–15 people</option>
      <option>15–50 people</option>
      <option>50–150 people</option>
      <option>150+ people</option>
    </select>
  </label>

  <input type="hidden" name="context" id="dfContext" value="" />

  <!-- honeypot: hidden from humans, bots fill it -->
  <input type="text" name="website" class="df__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <button type="submit" class="btn btn--primary btn--lg df__submit">Book my free demo</button>
  <p class="df__status" id="dfStatus" role="status" aria-live="polite"></p>
  <div class="df__recover" id="dfRecover" hidden>
    <div class="df__recover-acts">
      <button type="submit" class="btn btn--primary btn--sm">Try again</button>
      <a class="btn btn--ghost btn--sm" href={telLink}>Call {SITE.phone}</a>
      <a class="btn btn--ghost btn--sm" id="dfWa" href={waLink()} target="_blank" rel="noopener">Send on WhatsApp instead</a>
    </div>
  </div>
  <p class="df__note">No spam. We'll WhatsApp you to agree a time for a 20-minute walkthrough on your own numbers.</p>
</form>

<style>
  .df { display: grid; gap: 18px; }
  .df__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .df label {
    display: grid;
    gap: 8px;
    font-weight: 600;
    font-size: .88rem;
    color: var(--ink);
    letter-spacing: .01em;
  }
  .df input, .df select {
    font-family: inherit;
    font-size: 1rem;
    padding: 14px 16px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    width: 100%;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .df input::placeholder { color: #9ca3af; }
  .df input:focus, .df select:focus {
    border-color: var(--brand-500);
    outline: none;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, .1);
  }
  .df__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .df__submit { width: 100%; margin-top: 4px; }
  .df__submit[disabled] { opacity: .6; cursor: progress; }
  .df__status { margin: 0; font-weight: 600; font-size: .92rem; min-height: 1.2em; }
  .df__status[data-state="ok"] { color: var(--brand-700); }
  .df__status[data-state="err"] { color: var(--graphite-800); }
  .df__note { margin: 0; font-size: .82rem; color: var(--muted); }
  .df__recover { padding: 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); background: var(--brand-50, #f4f8ff); }
  .df__recover-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .df__recover-acts .btn { flex: 1 1 auto; }
  @media (max-width: 560px) { .df__row { grid-template-columns: 1fr; } }
</style>

<script>
  import { submitLead, waLink, newRequestId, trackAcceptedLead } from "../lib/lead-client.js";
  import { intentPayload } from "../lib/lead-intents.js";

  const form = document.getElementById("demoForm");
  const status = document.getElementById("dfStatus");
  const recover = document.getElementById("dfRecover");
  const waBtn = document.getElementById("dfWa");

  if (form) {
    // A CTA like /demo?from=ra-billing carries the workflow the visitor was
    // reading about into the enquiry, so they don't have to type it again.
    // Only a short slug is accepted — never an arbitrary query string.
    const FROM_LABELS = {
      "ra-billing": "RA billing workflow",
      "subcontractor-billing": "Subcontractor bill checking",
      "procurement": "Procurement & purchase approvals",
      "material-reconciliation": "BOQ vs actual consumption",
      "implementation": "Implementation & migration from Excel",
      "pricing": "Pricing / plan question",
      "platform": "Platform overview",
    };
    try {
      const from = (new URLSearchParams(location.search).get("from") || "").toLowerCase();
      if (/^[a-z0-9-]{1,40}$/.test(from)) {
        const ctx = document.getElementById("dfContext");
        if (ctx) ctx.value = `Came from: ${FROM_LABELS[from] || from}`;
      }
    } catch (_) { /* a malformed query string must not break the form */ }

    const endpoint = form.dataset.webhook || "";
    const fallbackEndpoint = form.dataset.fallback || "";
    const wa = form.dataset.wa;
    let requestId = newRequestId();
    let sending = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;
      const data = Object.fromEntries(new FormData(form));

      // Honeypot only. (A timing threshold used to silently drop fast and
      // autofilled submissions from real people — abuse control belongs on the
      // server, not in the visitor's browser.)
      if (data.website) return;
      delete data.website;

      if (!data.name || !data.company || !data.phone) {
        status.dataset.state = "err";
        status.textContent = "Please add your name, company and phone.";
        return;
      }

      const btn = form.querySelector("button[type=submit]");
      sending = true;
      btn.disabled = true;
      recover.hidden = true;
      status.dataset.state = "";
      status.textContent = "Sending…";

      const result = await submitLead(
        endpoint,
        {
          ...data,
          ...intentPayload({
            intent: "demo_request",
            placement: form.dataset.placement || "demo-form",
            source: "demo-form",
            context: data.context || "",
          }),
          page: location.pathname,
          referrer: document.referrer || "",
          landingSearch: location.search || "",
          submittedAt: new Date().toISOString(),
        },
        { requestId, fallbackEndpoint }
      );

      sending = false;
      btn.disabled = false;

      if (result.accepted) {
        trackAcceptedLead({ source: "demo-form", intent: "demo_request", page: location.pathname, leadId: result.leadId });
        window.location.href = "/thank-you";
        return;
      }

      // Delivery failed. Keep what they typed, tell the truth, offer a way out.
      requestId = newRequestId();
      status.dataset.state = "err";
      status.textContent = "We couldn't send that request. Your details are still here — try again, or use an option below.";
      if (waBtn) {
        waBtn.href = waLink(wa, [
          "New sotyn.ai demo request",
          `Name: ${data.name}`,
          `Company: ${data.company}`,
          `Phone: ${data.phone}`,
          `City: ${data.city || "-"}`,
          `Trade: ${data.trade || "-"}`,
          `Team: ${data.team || "-"}`,
        ]);
      }
      recover.hidden = false;
    });
  }
</script>
