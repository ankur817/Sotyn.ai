---
// Client-side calculator glue. Include once per page that renders <Calculator>.
// The arithmetic lives in src/lib/calc-formulas.js so it can be unit-tested.
// Reads the WhatsApp number from any [data-wa] element on the page.
---
<script>
  import { formulas } from "../lib/calc-formulas.js";

  const waEl = document.querySelector("[data-wa]");
  const WA = waEl ? waEl.getAttribute("data-wa") : "";

  const field = (slug, id) => document.getElementById(`${slug}__${id}`);

  function readInputs(el, slug) {
    const values = {};
    el.querySelectorAll("input, select").forEach((input) => {
      const id = input.id.split("__")[1];
      if (!id) return;
      values[id] = input.tagName === "SELECT" ? input.value : parseFloat(input.value) || 0;
    });
    return values;
  }

  function run(el, slug) {
    const fn = formulas[slug];
    if (!fn) return;
    const { outputs, message } = fn(readInputs(el, slug));
    for (const [id, value] of Object.entries(outputs)) {
      const out = field(slug, id);
      if (out) out.textContent = value;
    }
    const link = document.querySelector(`[data-wa-for="${slug}"]`);
    if (link && WA) {
      link.href =
        `https://wa.me/${WA}?text=` +
        encodeURIComponent(`${message} (via the sotyn.ai calculator) — I'd like a demo on my numbers.`);
    }
  }

  document.querySelectorAll("[data-calc]").forEach((el) => {
    const slug = el.getAttribute("data-calc");
    el.querySelectorAll("input, select").forEach((input) => {
      input.addEventListener("input", () => run(el, slug));
      input.addEventListener("change", () => run(el, slug));
    });
    run(el, slug);
  });
</script>
