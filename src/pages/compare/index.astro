---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config/site";

const items = [
  { slug: "sotyn-vs-rdash", name: "RDash", tag: "Generalist construction platform vs EPC-native depth." },
  { slug: "sotyn-vs-powerplay", name: "Powerplay", tag: "Site-collaboration app vs full quote-to-cash ERP." },
  { slug: "sotyn-vs-onsite", name: "Onsite", tag: "SMB site-tracking vs EPC billing, procurement & payroll." },
  { slug: "sotyn-vs-procore", name: "Procore", tag: "Global enterprise vs India-priced, EPC-native, GST-ready." },
  { slug: "sotyn-vs-tally", name: "Tally", tag: "Accounting software vs contractor operations — most firms keep both." },
  { slug: "sotyn-vs-zoho", name: "Zoho", tag: "Horizontal suite you configure vs an ERP that ships EPC-ready." },
  { slug: "sotyn-vs-odoo", name: "Odoo", tag: "Implementer-dependent open ERP vs done-for-you onboarding." },
];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Compare", item: `${SITE.url}/compare` },
  ],
};
---
<BaseLayout
  title="sotyn.ai vs RDash, Powerplay, Procore & More (2026)"
  description="Comparing construction & EPC software? Honest side-by-side breakdowns of sotyn.ai versus RDash, Powerplay, Onsite, Procore, Zoho and Odoo."
  path="/compare"
  schema={[breadcrumb]}
>
  <section class="section cmp-hero">
    <div class="container text-center">
      <span class="eyebrow">Honest comparisons</span>
      <h1>How sotyn.ai stacks up.</h1>
      <p class="lead" style="margin-inline:auto">We'd rather you choose with eyes open. Each page is fair — including where the other tool is genuinely the better fit — then shows where an EPC-native system pulls ahead.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cmp-grid">
        {items.map((i) => (
          <a class="cmp-card" href={`/compare/${i.slug}`}>
            <span class="cmp-card__vs">sotyn.ai <b>vs {i.name}</b></span>
            <p>{i.tag}</p>
            <span class="cmp-card__cta">Read the comparison <Icon name="arrow-right" size={15} /></span>
          </a>
        ))}
      </div>
      <div class="cmp-guide">
        <div>
          <span class="eyebrow">Not sure how to choose?</span>
          <h2>The 10 questions to ask any EPC ERP vendor.</h2>
          <p class="lead">A short, honest buyer's guide — the questions that separate a demo that looks good from software that survives a real project.</p>
        </div>
        <a href="/#demo" class="btn btn--primary btn--lg">Book a free demo</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container container--narrow">
      <div class="sec-head"><span class="eyebrow">How to read these</span><h2>The nine things worth comparing</h2></div>
      <p class="cmph-lead">
        Every comparison on this site uses the same nine rows, because these are the questions that decide
        whether contractor software survives contact with a real site. If you are evaluating anyone — including us —
        these are worth asking them directly.
      </p>
      <ol class="cmph-list">
        <li><strong>Bill types.</strong> Can it raise RA, MB, Installation and T&amp;C bills against a measurement, with GST, TDS and retention — or only a tax invoice? See <a href="/ra-billing-software">RA billing</a>.</li>
        <li><strong>Quoting from your own rates.</strong> Can a BOQ be priced line by line from your agreed rate masters, with margin visible before it goes out?</li>
        <li><strong>Procurement chain.</strong> Does a site indent become an RFQ, an approval, a PO and a receipt that all trace back to one request? See <a href="/construction-procurement-software">procurement approvals</a>.</li>
        <li><strong>Subcontractor bill checking.</strong> Is the bill priced from the contract rate and checked against measured quantity before certification? See <a href="/subcontractor-billing-software">bill checking</a>.</li>
        <li><strong>Attendance and payroll.</strong> Does site attendance actually reach payroll, or is it a separate system and a monthly re-key?</li>
        <li><strong>The owner's view.</strong> Committed against actual cost while the job runs — not a report at closeout.</li>
        <li><strong>Who built it.</strong> Whether anyone in the building has run a contracting business on it.</li>
        <li><strong>Where the data lives</strong>, and what happens to it if you leave.</li>
        <li><strong>Published pricing.</strong> Whether the price is on the website at all, and what onboarding costs on top. Ours is on <a href="/pricing">the pricing page</a>.</li>
      </ol>
      <p class="cmph-note">
        Every competitor claim on these pages is checked against that company's own website, with the date it was
        checked. Where their public pages do not state something, we say so rather than assume they cannot do it —
        and we would rather you verified both sides than took our word for it.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .cmp-hero h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .cmp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cmp-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px 22px 20px; box-shadow: var(--shadow-sm); transition: .2s; }
  .cmp-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--brand-100); text-decoration: none; }
  .cmp-card__vs { font-size: 1.15rem; font-weight: 800; color: var(--ink); letter-spacing: -.02em; }
  .cmp-card__vs b { color: var(--brand-700); }
  .cmp-card p { font-size: .93rem; color: var(--body); margin: 8px 0 16px; flex: 1; }
  .cmp-card__cta { font-weight: 700; color: var(--brand-700); font-size: .9rem; display: inline-flex; align-items: center; gap: 6px; }
  .cmp-guide { margin-top: 22px; background: var(--brand-50); border: 1px solid var(--brand-100); border-radius: 18px; padding: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cmp-guide h2 { margin: 6px 0 8px; font-size: 1.5rem; }
  .cmp-guide .lead { margin: 0; max-width: 560px; }
  @media (max-width: 860px) { .cmp-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cmp-grid { grid-template-columns: 1fr; } }
  .cmph-lead { font-size: 1.02rem; line-height: 1.7; margin: 0 0 18px; }
  .cmph-list { margin: 0; padding-left: 22px; display: grid; gap: 11px; line-height: 1.65; }
  .cmph-list strong { color: var(--ink); }
  .cmph-note { margin: 22px 0 0; padding-left: 14px; border-left: 3px solid var(--brand-500); color: var(--muted); line-height: 1.7; font-size: .95rem; }
</style>
