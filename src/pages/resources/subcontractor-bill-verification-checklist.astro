---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChecklistPage from "../../components/ChecklistPage.astro";
import { SITE } from "../../config/site";
import { CHECKLISTS } from "../../data/checklists.js";

const c = CHECKLISTS["subcontractor-bill-verification-checklist"];
const schema = [{
  "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Resources", item: `${SITE.url}/resources` },
    { "@type": "ListItem", position: 3, name: c.h1, item: `${SITE.url}/resources/subcontractor-bill-verification-checklist` },
  ],
}];
---
<BaseLayout title={c.title} description={c.description} path="/resources/subcontractor-bill-verification-checklist" schema={schema}>
  <ChecklistPage c={c} />
</BaseLayout>
