---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { SITE, waLink } from "../../config/site";

export function getStaticPaths() {
  const verticals = {
  "mep-contractors": {
    context: "Most MEP contracts run all four disciplines at once — HVAC and ductwork, HT/LT electrical, plumbing and public health, and fire-fighting with its own statutory approvals. They are measured in different units, billed on different milestones, and usually subcontracted to different agencies. The system has to hold all of that against one contract without flattening it into a single line.",
    does: [["Per-trade measurement and billing", "Ducting in running metres, conduit in metres, sanitary in numbers — measured as they are on site, then billed as RA, MB, Installation or T&C with GST, TDS and retention."], ["Subcontract packages per trade", "Each agency carries its own rate master, advances and retention. Their bills are checked against measured quantity and the agreed rate before certification."], ["Fire NOC renewals tracked", "Statutory renewal dates held against the project instead of in somebody's diary."], ["One margin view across trades", "Committed against actual cost per trade and per site, while the job is still running."]],
    notDoes: "It does not do drawing takeoff. Quantities come from your BOQ or your own measurement, not from a DWG or a BIM model, and it does not replace your CAD workflow.",
    faqs: [["Can we run electrical, HVAC, plumbing and fire on one contract?", "Yes — one project with separate trade packages, each with its own rate master, subcontractor and measurement basis, rolling up into a single margin view."], ["Does it handle MB-based billing?", "Yes. Measurement book billing is a supported bill type alongside Sales, RA, Installation and T&C, all with GST, TDS and retention."], ["We subcontract most trades. Does that work?", "That is the normal case. Subcontractor bills are priced from the agreed rate master and checked against measured quantity before anyone certifies them."]],
    name: "MEP contractors",
    metaTitle: "ERP Software for MEP Contractors | sotyn.ai",
    metaDesc: "ERP for MEP contractors — mechanical, electrical, plumbing and fire. RA/MB billing that matches your measurement book, and live margin across trades.",
    kicker: "For MEP contractors",
    h1: "The ERP built for MEP contractors.",
    intro: "MEP means four trades on one contract — mechanical and HVAC, electrical, plumbing and public health, and fire-fighting — each measured differently and often subcontracted separately. sotyn.ai prices from your own rate masters, bills exactly how you measure, and shows margin across every trade and site on one screen.",
    pains: ["Quotes take days in Excel — and one wrong rate sinks the job", "RA bills lag the measurement book, so cash sits on site", "Many trades, many sites — no single view of margin"],
    fits: [
      { icon: "trending-up", t: "Estimator and rate masters", d: "Price a BOQ line by line from your own agreed rates, with cost and margin visible before the quote goes out." },
      { icon: "wallet", t: "RA / MB billing", d: "Bill exactly how you measure — RA, MB, Installation and T&C bill types, with GST." },
      { icon: "building", t: "Multi-trade site execution", d: "Daily reports, snags and checklists across every trade and site, from the phone." },
      { icon: "gauge", t: "Owner's War Room", d: "Live margin, cash and the ₹/day bottleneck across all your MEP jobs." },
    ],
  },
  "solar-epc": {
    context: "Solar EPC has a rhythm the other trades do not: a kW-based estimate, a long procurement lead on modules and inverters, a fast installation window, then commissioning, DISCOM approval and net-metering paperwork before the final payment is anywhere in sight. The money sits in that last stretch.",
    does: [["Module and inverter procurement", "Indent, rate comparison, purchase order and receiving for modules, inverters, structures and balance-of-system, with approval limits suited to large single orders."], ["Per-site stock and movement", "What arrived at which site, what moved between sites and what is left — so the next order starts from reality rather than memory."], ["Installation and commissioning", "Daily reports, checklists and snags through to handover, filed from a phone at site."], ["Retention and collections", "Retention held per bill with its release date, and receivables aged — so the tail end of a solar job gets chased."]],
    notDoes: "It does not file DISCOM applications, produce net-metering paperwork or assess subsidy eligibility — those stay with your liaison team. It also does not do shadow analysis, string design or yield simulation; it runs the commercial and execution side around the design you already have.",
    faqs: [["Does it do solar design or yield calculation?", "No. Design, string layout and yield simulation stay in your design tools. sotyn.ai covers quoting from your rates, procurement, site execution, billing and collections."], ["Can it handle both rooftop and ground-mount projects?", "Yes — they are projects with different BOQs and procurement profiles. The workflow is the same."], ["How is commissioning billing handled?", "Through the Installation and T&C bill types, with retention held and its release date tracked."]],
    name: "Solar EPC",
    metaTitle: "ERP Software for Solar EPC Companies | sotyn.ai",
    metaDesc: "Run your solar EPC business end-to-end — kW-based estimation, module & inverter procurement, installation, commissioning and RA billing.",
    kicker: "For solar EPC",
    h1: "Run your solar EPC business end-to-end.",
    intro: "From kW-based estimation to procurement, installation and commissioning, sotyn.ai keeps your whole solar EPC lifecycle in one system — with a dedicated solar division, not a generic bolt-on.",
    pains: ["kW estimates and BOQs rebuilt from scratch for every tender", "Module and inverter procurement scattered across sheets", "Commissioning and T&C billing tracked by hand"],
    fits: [
      { icon: "gauge", t: "Solar division built in", d: "A dedicated solar sales funnel and kW-based estimation — designed for solar, not adapted to it." },
      { icon: "box", t: "Procurement engine", d: "Indent → PO → payment for modules, inverters and balance-of-system, with approvals." },
      { icon: "building", t: "Install & commissioning", d: "Site execution, checklists and T&C billing all the way through to handover." },
      { icon: "wallet", t: "Cash & collections", d: "RA billing, retention tracking and AR/AP so solar payments don't slip." },
    ],
  },
  "civil-contractors": {
    context: "Civil work is labour-heavy and material-heavy at once. Margin moves with three things: whether the muster roll matches who was actually on site, whether consumption matches the BOQ, and whether the gang or piece-rate subcontractor billed what was really measured.",
    does: [["Gang and piece-rate billing", "Rate masters for gang and piece-rate work, so a subcontractor bill is priced from the agreed contract rather than from the bill they hand you."], ["Material against BOQ", "Consumption reconciled per line and per site, so over-consumption surfaces during the job instead of at closeout."], ["Attendance into payroll", "Site attendance flows into payroll with PF, ESI and TDS, so the muster roll and the wage sheet agree."], ["RA and MB billing to the client", "Measured quantities billed with GST, TDS and retention, ready the day a daily report is approved."]],
    notDoes: "It does not produce RERA filings, structural design or quantity takeoff from drawings. It is the operating system around the work, not a compliance filing service.",
    faqs: [["Do you support gang-rate and piece-rate subcontractors?", "Yes — each package carries its own agreed rates, advances and retention, and bills are checked against measured quantity before certification."], ["Can site staff file from a basic phone?", "Yes, through the browser. There is no app to install, and site users are never charged per seat."], ["Does it track material issued to a subcontractor?", "Yes, and it is recovered as a deduction on their bill rather than remembered by one person."]],
    name: "Civil contractors",
    metaTitle: "ERP Software for Civil Contractors in India | sotyn.ai",
    metaDesc: "Built for labour-heavy civil sites — geofenced attendance to payroll, material reconciliation, RA/MB billing and a ₹/day War Room.",
    kicker: "For civil contractors",
    h1: "Built for labour-heavy civil sites.",
    intro: "Civil work is labour- and material-heavy, and that's exactly where money leaks. sotyn.ai makes the muster roll match reality, reconciles material issued against consumed, and shows the CMD which site is bleeding money today.",
    pains: ["Ghost labour and inflated overtime on the muster roll", "Material issued vs consumed is never reconciled", "The CMD can't see which site is bleeding money"],
    fits: [
      { icon: "users", t: "Geofenced attendance", d: "GPS + selfie attendance straight to auto payroll — the roll matches who was really on site." },
      { icon: "box", t: "Material reconciliation", d: "Indent, PO, GRN and issued-vs-consumed, so wastage finally shows up." },
      { icon: "wallet", t: "EPC billing & cash", d: "RA/MB billing with GST, retention tracking and AR/AP in one place." },
      { icon: "gauge", t: "₹/day War Room", d: "See which constraint on which site is costing the most, right now." },
    ],
  },
  "industrial-epc": {
    context: "Turnkey and industrial EPC means several disciplines, several subcontractors and often several sites running against one contract value — with the client holding retention on every bill and a P&L nobody sees until the job closes. The problem is rarely any single trade; it is the roll-up.",
    does: [["One contract, many packages", "Each discipline and subcontract package carries its own BOQ, rates and billing, rolling into one project position."], ["Procurement with approval limits", "Value-based L1/L2 approvals with the vendor comparison attached, so a large industrial order has a trail that survives an audit."], ["Committed against actual", "What has been ordered, what has been consumed and what has been billed, per package, while the project runs."], ["Owner's console", "Margin, cash and the current bottleneck across every site, without waiting for a monthly review."]],
    notDoes: "It does not do engineering design, P&ID or plant simulation, and it does not replace a client's own project-controls system. It runs your side of the contract.",
    faqs: [["Can one project hold several subcontract packages?", "Yes — that is the normal shape of a turnkey contract. Each package has its own rates, bills and retention."], ["Do we get project-wise profitability while the job runs?", "Yes: committed cost, actual cost and billed value per project and per package, rather than a number at closeout."], ["How are multi-site projects handled?", "Stock, attendance and daily reports are per site; the commercial roll-up is per project."]],
    name: "Industrial & turnkey EPC",
    metaTitle: "ERP for Industrial & Turnkey EPC Contractors | sotyn.ai",
    metaDesc: "One console for turnkey EPC — engineering, quotation, procurement, site execution, billing and collection, with an owner's War Room.",
    kicker: "For industrial & turnkey EPC",
    h1: "One console for turnkey EPC.",
    intro: "Turnkey and industrial EPC means many trades, many sites and one P&L. sotyn.ai puts the whole lifecycle in one system so the owner can delegate and still see the money — instead of firefighting to month-end.",
    pains: ["Every trade and site lives in a different tool or sheet", "The owner firefights instead of delegating", "Margin is known only at month-end — too late to act"],
    fits: [
      { icon: "target", t: "Quote to cash, one system", d: "Engineering, quotation, procurement, site, billing and collection — together, not stitched." },
      { icon: "gauge", t: "Delegate with control", d: "Delegations, scorecards and a War Room, so you delegate and still see the money." },
      { icon: "box", t: "Full procurement", d: "L1/L2 approvals, PO pipeline, debit notes, dispatch and receiving." },
      { icon: "shield", t: "Your data, in India", d: "A private workspace, nightly offsite backups and a full audit log." },
    ],
  },
  };
  return Object.entries(verticals).map(([slug, v]) => ({ params: { slug }, props: { v, slug } }));
}
const { v, slug } = Astro.props as { v: any; slug: string };

const faqSchema = v.faqs
  ? [{ "@context": "https://schema.org", "@type": "FAQPage",
       mainEntity: v.faqs.map(([q, a]: [string, string]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }]
  : [];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Platform", item: `${SITE.url}/platform` },
    { "@type": "ListItem", position: 3, name: v.name, item: `${SITE.url}/solutions/${slug}` },
  ],
};
---
<BaseLayout title={v.metaTitle} description={v.metaDesc} path={`/solutions/${slug}`} schema={[breadcrumb, ...faqSchema]}>
  <nav class="crumb" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/platform">Platform</a> <span aria-hidden="true">/</span> <span>{v.name}</span></div>
  </nav>
  <section class="section sol-hero">
    <div class="container">
      <span class="eyebrow">{v.kicker}</span>
      <h1>{v.h1}</h1>
      <p class="lead">{v.intro}</p>
      <div class="btn-row">
        <a href="/#demo" class="btn btn--primary btn--lg">Book a free demo</a>
        <a href={waLink(`Hi sotyn.ai, I run ${v.name.toLowerCase()} work — I'd like a demo.`)} class="btn btn--ghost btn--lg">WhatsApp us</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">Sound familiar?</span>
      <h2>The leaks {v.name.toLowerCase()} feel most.</h2>
      <div class="sol-pains">
        {v.pains.map((p: string) => (
          <div class="pain"><Icon name="x" size={16} /> <span>{p}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">How sotyn.ai fits</span>
      <h2>Built for how you actually work.</h2>
      <div class="sol-fits">
        {v.fits.map((f: any) => (
          <div class="fit">
            <div class="fit__ic"><Icon name={f.icon} size={22} /></div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {v.context && (
    <section class="section">
      <div class="container container--narrow">
        <div class="sec-head"><span class="eyebrow">What the work involves</span><h2>How {v.name.toLowerCase()} actually run a contract</h2></div>
        <p class="sol-context">{v.context}</p>
        <div class="sol-does">
          {v.does.map(([t, d]) => (
            <div class="sol-do"><h3>{t}</h3><p>{d}</p></div>
          ))}
        </div>
        {v.notDoes && (
          <p class="sol-not"><strong>What it does not do.</strong> {v.notDoes}</p>
        )}
      </div>
    </section>
  )}

  {v.faqs && (
    <section class="section section--alt">
      <div class="container container--narrow">
        <div class="sec-head"><span class="eyebrow">Questions from {v.name.toLowerCase()}</span><h2>Straight answers</h2></div>
        <div class="sol-faq">
          {v.faqs.map(([q, a]) => (
            <details><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow" style="color:var(--brand-100)">The proof</span>
      <h2 style="color:#fff">Run on real EPC sites, not a demo.</h2>
      <div class="sol-stats">
        {SITE.stats.map((s) => (<div class="sol-stat"><strong>{s.value}</strong><span>{s.label}</span></div>))}
      </div>
      <div class="btn-row" style="justify-content:center;margin-top:26px">
        <a href="/#demo" class="btn btn--white btn--lg">See it on your numbers</a>
      </div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--narrow text-center">
      <p class="lead" style="margin-inline:auto">
        Work across more than one trade? <a href="/epc-erp-software">EPC ERP software</a> covers
        the whole contract, and the workflows behind it are here:
        <a href="/construction-procurement-software">procurement approvals</a>,
        <a href="/ra-billing-software">RA billing</a> and
        <a href="/subcontractor-billing-software">subcontractor bill checking</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .sol-hero h1 { font-size: clamp(2rem, 5vw, 3rem); max-width: 12ch; }
  .sol-hero .lead { max-width: 640px; }
  .sol-pains { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
  .pain { display: flex; gap: 10px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--graphite-700); border-radius: 12px; padding: 16px 18px; font-weight: 600; color: var(--ink); }
  .pain :global(svg) { color: var(--graphite-500); flex: none; margin-top: 2px; }
  .sol-fits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 22px; }
  .fit { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px 20px; box-shadow: var(--shadow-sm); }
  .fit__ic { width: 46px; height: 46px; border-radius: 12px; background: var(--brand-50); color: var(--brand-700); display: grid; place-items: center; margin-bottom: 14px; }
  .fit h3 { font-size: 1.05rem; margin-bottom: 7px; }
  .fit p { font-size: .92rem; color: var(--body); margin: 0; }
  .sol-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 30px; margin-top: 22px; }
  .sol-stat strong { display: block; font-size: 2rem; font-weight: 800; color: #fff; letter-spacing: -.02em; }
  .sol-stat span { color: var(--brand-100); font-size: .9rem; }
  @media (max-width: 860px) { .sol-pains, .sol-fits { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .sol-pains, .sol-fits { grid-template-columns: 1fr; } }
  .sol-context { font-size: 1.05rem; line-height: 1.75; margin: 0 0 22px; }
  .sol-does { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
  .sol-do { padding: 20px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-elevated, #fff); }
  .sol-do h3 { margin: 0 0 7px; font-size: 1.02rem; }
  .sol-do p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.6; }
  .sol-not { margin: 22px 0 0; padding-left: 14px; border-left: 3px solid var(--brand-500); color: var(--muted); line-height: 1.7; }
  .sol-faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .sol-faq details:last-child { border-bottom: 0; }
  .sol-faq summary { cursor: pointer; font-weight: 600; }
  .sol-faq summary:focus-visible { outline: 3px solid var(--brand-500); outline-offset: 3px; }
  .sol-faq p { margin: 10px 0 0; color: var(--muted); line-height: 1.65; }
</style>
