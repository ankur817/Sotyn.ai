---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { SITE, waLink } from "../../config/site";

// Capability rows — the axes an EPC contractor actually decides on.
const caps = [
  "EPC bill types (Sales / RA / MB / Installation / T&C) with GST",
  "AI BOQ → priced quote, margin per line",
  "Procurement — Indent → PO → Payment, L1/L2 approvals",
  "Geofenced attendance + payroll, built in",
  "TOC War Room — ₹/day bottleneck costing",
  "Built & run by a live EPC company",
  "Data hosted in India, private workspace",
  "Transparent public pricing",
  "Risk-reversal guarantee",
];
const us = ["Native", "Yes — Excel/PDF", "Full engine", "Yes — no 2nd app", "Yes", "Yes — customer #1", "Yes", "₹6K–₹12.5K/mo", "30-day money-back"];

export function getStaticPaths() {
  const rivals = {
  "sotyn-vs-rdash": {
    name: "RDash",
    metaTitle: "sotyn.ai vs RDash: An Honest Comparison (2026)",
    metaDesc: "sotyn.ai vs RDash for EPC contractors — EPC-native billing, AI BOQ quoting and ₹/day TOC costing. An honest, side-by-side comparison.",
    tag: "Generalist construction platform vs EPC-native depth",
    coreDiff: "RDash is a capable construction-management platform with a genuinely simple interface and reach across many construction segments. sotyn.ai is narrower on purpose: it's built by Secured Engineers — a 14-year EPC company — to run its own 535+ projects across 18 states, and then offered to peers. That origin shows up in the parts generalists tend to simplify: EPC-native billing, BOQ-to-quote pricing, and costing bottlenecks in rupees per day.",
    strong: ["Simple, polished interface", "Serves construction broadly, beyond EPC", "90-day deployment guarantee"],
    vals: ["General billing*", "Estimation module*", "Yes", "Attendance/payroll not stated*", "Dashboards, not ₹/day TOC", "No — software company", "*", "USD 1,000/user/yr published*", "Deployment guarantee"],
    them: "If you run mixed construction beyond EPC, want a big-brand vendor with outside funding, or prefer their specific UI, RDash is a fair pick — demo both.",
    win: "If you need RA/MB/T&C billing that matches your measurement book, BOQ-to-quote pricing with per-line margin, and a CMD console that costs delays in ₹/day — from a team that runs an EPC business on it daily — sotyn.ai was built for exactly you.",
  },
  "sotyn-vs-powerplay": {
    name: "Powerplay",
    metaTitle: "sotyn.ai vs Powerplay: EPC ERP vs Site App (2026)",
    metaDesc: "sotyn.ai vs Powerplay — a full quote-to-cash EPC ERP versus a site-collaboration app. Compare billing, procurement, payroll and owner dashboards.",
    tag: "Site-collaboration app vs full quote-to-cash ERP",
    coreDiff: "Powerplay is loved for field and daily-progress collaboration — it's a strong site app. sotyn.ai is a full ERP: the same site execution, plus EPC billing, procurement, HRMS-payroll, quotation and an owner's control tower in one system, so money and site live together.",
    strong: ["Excellent field / DPR experience", "Popular with site teams", "Free trial to get started"],
    vals: ["Billing scope not stated*", "Estimation*", "Material & PO mgmt", "Attendance + payroll", "Reports, not ₹/day TOC", "No", "*", "Not published*", "—"],
    them: "If all you need is site updates and task collaboration for a small team, Powerplay is quick and pleasant to start with.",
    win: "If you want the site AND the money — billing, cash, procurement and payroll — in one system that an owner can run the whole company from, sotyn.ai goes further.",
  },
  "sotyn-vs-onsite": {
    name: "Onsite",
    metaTitle: "sotyn.ai vs Onsite: EPC ERP vs Site Tracker (2026)",
    metaDesc: "sotyn.ai vs Onsite — per-company pricing with unlimited site users against Onsite's published per-user pricing. Compare EPC billing, procurement and payroll.",
    tag: "Per-user pricing vs one price per company, with EPC bill types",
    coreDiff: "Onsite covers project tracking, procurement and billing and is priced per user — ₹12,000 per user per year with a five-user minimum, plus paid add-ons for Tally and Zoho integrations (their published pricing, checked September 2026). sotyn.ai is priced per company instead, so every site worker is included, and it ships with EPC bill types — RA, MB and T&C — that Onsite does not name publicly.",
    strong: ["Fast to start", "Publishes its pricing openly", "Integrations with Tally, Zoho Books, SAP and Excel"],
    vals: ["Client invoicing & vendor billing; RA/MB not stated*", "Estimation*", "Procurement + multi-level approvals", "GPS attendance*", "Dashboards", "No", "*", "₹12,000/user/yr, min 5 users*", "—"],
    them: "If you have a small office team and want per-user pricing with published integrations to Tally or Zoho Books, Onsite is a straightforward choice — and they serve EPC companies too. Compare the per-user total against a per-company price at your headcount.",
    win: "The day you need real EPC billing, procurement approvals and payroll — not just tracking — sotyn.ai is the system you grow into.",
  },
  "sotyn-vs-procore": {
    name: "Procore",
    metaTitle: "sotyn.ai vs Procore for Indian EPC Contractors (2026)",
    metaDesc: "sotyn.ai vs Procore — India-priced, EPC-native and GST-ready versus a global enterprise construction platform. Compare fit, price and billing for Indian EPC.",
    tag: "Global enterprise platform vs India-priced, EPC-native",
    coreDiff: "Procore is a mature, deep, global platform — and priced and built for that market. sotyn.ai is built for Indian EPC reality: RA/MB/T&C bill types with GST, ₹-based costing, data hosted in India, at a price a ₹5–100 Cr contractor can actually run on.",
    strong: ["Deep enterprise feature set", "500+ integrations in their marketplace", "Unlimited users in every contract"],
    vals: ["Global types, not India EPC*", "Estimating add-on*", "Yes*", "Resource management; payroll not stated*", "Analytics, not ₹/day TOC", "No — US software co.", "India residency not stated*", "Priced by product + construction volume*", "—"],
    them: "If you're a large enterprise with global operations and the budget to match, Procore's depth is hard to beat.",
    win: "If you're an Indian EPC contractor who needs GST-ready RA/MB billing and India-hosted data without an enterprise price tag, sotyn.ai fits the way you actually work.",
  },
  "sotyn-vs-zoho": {
    name: "Zoho",
    metaTitle: "sotyn.ai vs Zoho: EPC-Ready ERP vs Horizontal Suite (2026)",
    metaDesc: "sotyn.ai vs Zoho — a vertical ERP that ships EPC-ready versus a horizontal suite you configure yourself. Compare billing, BOQ quoting and setup effort.",
    tag: "Horizontal suite you configure vs vertical ERP that ships EPC-ready",
    coreDiff: "Zoho is a broad, affordable suite you assemble and configure into a workflow. sotyn.ai arrives already shaped for EPC — BOQ estimation, RA/MB/T&C billing and site execution are built in, not something you stitch together across Books, Projects, Inventory and People.",
    strong: ["Vast, affordable ecosystem", "Low per-user cost", "Familiar to many teams"],
    vals: ["Generic invoicing (Books)", "BOQ not native*", "Via Zoho Inventory", "Zoho People (add-on)", "Analytics, DIY", "No — software suite", "India DC available", "Per-user, public", "—"],
    them: "If you have the appetite to configure and maintain a suite, and want the wider Zoho ecosystem, it's flexible and cheap per seat.",
    win: "If you'd rather buy software that already knows what an RA bill and a BOQ are — and never pay per site worker — sotyn.ai is EPC-ready on day one.",
  },
  "sotyn-vs-tally": {
    name: "Tally",
    metaTitle: "sotyn.ai vs Tally: Operations vs Accounting (2026)",
    metaDesc: "Keep Tally for the books. See what a contractor ERP adds on top: RA and MB billing, site indents, purchase approvals and subcontractor bill checking.",
    tag: "Accounting software vs contractor operations — most firms need both",
    coreDiff: "This is not really a head-to-head. TallyPrime is accounting software, and it is very good at being accounting software — vouchers, GST, e-invoicing, e-way bills, inventory and statutory returns. It is not built to run a site: there is no RA or MB bill against a measurement, no site indent raised against a BOQ line, no L1/L2 purchase approval trail, no daily progress report. sotyn.ai runs those operations. Most contractors keep Tally for the books and move projects, procurement and billing here — which is why we migrate your Tally masters at setup rather than asking you to abandon them.",
    strong: ["The accounting standard in India — your CA already knows it", "Published pricing, from ₹750/month", "GST, e-invoicing and e-way bills handled properly"],
    vals: ["Accounting invoices with GST; RA/MB against measurement not an accounting feature*", "No BOQ-to-quote*", "Purchase orders in order processing; no site indent → L1/L2 approval chain*", "Payroll module; site attendance not its job*", "Financial reports, not ₹/day project bottleneck costing", "No — an accounting software company", "Runs on your own PCs or Tally's cloud access add-on*", "Published: ₹750–₹2,250/mo, or ₹22,500–₹67,500 lifetime + 18% GST*", "—"],
    them: "Keep Tally. If your question is really about vouchers, GST returns, e-invoicing or your balance sheet, that is Tally's job and nothing here replaces it — your accountant should stay where they are productive.",
    win: "If the problem is that site, procurement and billing live in WhatsApp and Excel and only reach Tally after the fact, that is the gap sotyn.ai fills: indents and approvals with a trail, RA and MB bills built from measurements and the agreed rate master, subcontractor bills checked before they are paid, and the owner's view while the job is running.",
  },
  "sotyn-vs-odoo": {
    name: "Odoo",
    metaTitle: "sotyn.ai vs Odoo: Done-for-You EPC ERP vs Open-Source (2026)",
    metaDesc: "sotyn.ai vs Odoo — a done-for-you, EPC-native ERP versus a flexible open-source platform that depends on an implementer. Compare fit, billing and onboarding.",
    tag: "Implementer-dependent open ERP vs done-for-you EPC onboarding",
    coreDiff: "Odoo is a powerful, flexible open-source ERP — but for EPC it depends heavily on an implementer to build and maintain the workflows. sotyn.ai ships EPC-native and is onboarded for you by a team that runs an EPC company, so you go live on your real data fast.",
    strong: ["Highly flexible and modular", "Open-source foundation", "A free tier for a single app, unlimited users"],
    vals: ["Generic accounting*", "BOQ not native*", "Purchase module", "Odoo HR (config)*", "DIY dashboards", "No — open-source ERP", "Odoo Online, or self/partner hosted", "From ₹725/user/mo + implementer*", "—"],
    them: "If you have strong in-house or partner ERP capability and want total flexibility, Odoo can be shaped into almost anything.",
    win: "If you'd rather not run an ERP project — and just want EPC billing, quoting and payroll working next month — sotyn.ai is done for you.",
  },
  };
  return Object.entries(rivals).map(([slug, r]) => ({ params: { slug }, props: { r, slug } }));
}
const { r, slug } = Astro.props as { r: any; slug: string };

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Compare", item: `${SITE.url}/compare` },
    { "@type": "ListItem", position: 3, name: `sotyn.ai vs ${r.name}`, item: `${SITE.url}/compare/${slug}` },
  ],
};
---
<BaseLayout title={r.metaTitle} description={r.metaDesc} path={`/compare/${slug}`} schema={[breadcrumb]}>
  <nav class="crumb" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/compare">Compare</a> <span aria-hidden="true">/</span> <span>vs {r.name}</span></div>
  </nav>
  <section class="section cmp-hero">
    <div class="container text-center">
      <span class="eyebrow">Honest comparison · 2026</span>
      <h1>sotyn.ai <span class="hl">vs {r.name}</span></h1>
      <p class="lead" style="margin-inline:auto">{r.tag}. For the EPC contractor deciding between them — including where {r.name} is genuinely strong.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/#demo" class="btn btn--primary btn--lg">Book a free demo</a>
        <a href="/compare" class="btn btn--ghost btn--lg">All comparisons</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cmp-core">
        <span class="eyebrow">Side by side</span>
        <h2 class="cmp-core__h">The core difference</h2>
        <p>{r.coreDiff}</p>
      </div>
      <div class="ctable-wrap">
        <table class="ctable">
          <thead>
            <tr><th>Capability</th><th class="c-us">sotyn.ai</th><th>{r.name}</th></tr>
          </thead>
          <tbody>
            {caps.map((c, i) => (
              <tr>
                <td>{c}</td>
                <td class="c-us"><Icon name="check" size={15} /> {us[i]}</td>
                <td set:html={r.vals[i].replace("*", '<span class="vf">*</span>')}></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="ctable-note"><span class="vf">*</span> Checked against {r.name}'s own website in September 2026. Where their public pages don't state something, we say so rather than assume they can't do it — verify against their current product before relying on this.</p>
    </div>
  </section>

  <section class="section">
    <div class="container cmp-verdict">
      <div class="vcard">
        <h2 class="cmp-sub"><Icon name="check" size={18} /> Where {r.name} may suit you better</h2>
        <ul class="tick">{r.strong.map((s: string) => (<li>{s}</li>))}</ul>
        <p>{r.them}</p>
      </div>
      <div class="vcard vcard--us">
        <h2 class="cmp-sub"><Icon name="bolt" size={18} /> Where sotyn.ai wins</h2>
        <p>{r.win}</p>
        <a href="/#demo" class="btn btn--primary">See it on your numbers →</a>
      </div>
    </div>
  </section>

  <section class="section section--dark cmp-cta">
    <div class="container text-center">
      <h2>The only real test is your own numbers.</h2>
      <p class="lead" style="margin-inline:auto">A 20-minute demo on your trades and project sizes — not a generic slideshow. Then decide.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/#demo" class="btn btn--white btn--lg">Book a free demo</a>
        <a href={waLink(`Hi sotyn.ai, I'm comparing you with ${r.name} — can I get a demo?`)} class="btn btn--ghost-w btn--lg">WhatsApp us</a>
      </div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="sec-head text-center">
        <span class="eyebrow">Judge it on the work</span>
        <h2>The workflows this comparison is really about</h2>
      </div>
      <div class="nextgrid">
        <a class="nextcard" href="/construction-procurement-software"><strong>Procurement &amp; approvals</strong><span>Indent against a BOQ line, rate comparison, L1/L2 approval, PO, receipt.</span></a>
        <a class="nextcard" href="/subcontractor-billing-software"><strong>Subcontractor bill checking</strong><span>Measured quantity against the agreed rate master, deductions by rule.</span></a>
        <a class="nextcard" href="/ra-billing-software"><strong>RA billing</strong><span>Sales, RA, MB, Installation and T&amp;C, with GST, TDS and retention.</span></a>
        <a class="nextcard" href="/construction-erp-implementation"><strong>Implementation</strong><span>What moving off your current setup actually involves.</span></a>
      </div>
      <p class="cmp-more">
        Comparing more than one? See <a href="/compare">all comparisons</a>, or read
        <a href="/pricing">what sotyn.ai costs</a> before you shortlist.
      </p>
    </div>
  </section>

<style is:global>
  .nextgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .nextcard { display: block; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-elevated, #fff); text-decoration: none; color: inherit; }
  .nextcard:hover { border-color: var(--brand-500); }
  .nextcard strong { display: block; margin-bottom: 5px; }
  .nextcard span { font-size: .88rem; color: var(--muted); line-height: 1.5; }
  .cmp-more { margin: 18px 0 0; font-size: .92rem; color: var(--muted); text-align: center; }
  .cmp-core__h { font-size: 1.5rem; margin: 6px 0 12px; }
  .cmp-sub { font-size: 1.1rem; display: flex; align-items: center; gap: 8px; margin: 0 0 10px; }
</style>
</BaseLayout>

<style>
  .cmp-hero h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .cmp-core { max-width: 760px; margin: 0 auto 28px; }
  .cmp-core p { font-size: 1.06rem; color: var(--body); margin-top: 8px; }
  .ctable-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; background: #fff; box-shadow: var(--shadow-sm); }
  .ctable { border-collapse: collapse; width: 100%; min-width: 620px; font-size: .95rem; }
  .ctable th, .ctable td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .ctable thead th { background: var(--graphite-900); color: #fff; font-size: .85rem; letter-spacing: .02em; }
  .ctable thead th.c-us { background: var(--brand-700); }
  .ctable td.c-us { color: var(--brand-800); font-weight: 700; background: var(--brand-50); }
  .ctable td.c-us :global(svg) { color: var(--brand-600); vertical-align: -2px; }
  .ctable tbody tr:last-child td { border-bottom: 0; }
  .ctable :global(.vf) { color: var(--brand-600); font-weight: 800; }
  .ctable-note { font-size: .84rem; color: var(--muted); margin-top: 12px; max-width: 760px; }
  .cmp-verdict { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .vcard { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 26px 26px 28px; box-shadow: var(--shadow-sm); }
  .vcard--us { border-color: var(--brand-200, #bfdbfe); background: var(--brand-50); }
  .vcard h3 { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .vcard h3 :global(svg) { color: var(--brand-600); }
  .vcard p { color: var(--body); margin: 10px 0 16px; }
  .tick { list-style: none; padding: 0; margin: 0 0 8px; }
  .tick li { position: relative; padding-left: 22px; margin: 7px 0; color: var(--body); font-weight: 600; }
  .tick li::before { content: "✓"; position: absolute; left: 0; color: var(--brand-600); font-weight: 800; }
  .cmp-cta h2 { color: #fff; }
  .btn--ghost-w { border: 1px solid rgba(255,255,255,.4); color: #fff; }
  @media (max-width: 720px) { .cmp-verdict { grid-template-columns: 1fr; } }
</style>
