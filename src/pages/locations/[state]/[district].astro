---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DistrictPage from "../../../components/DistrictPage.astro";
import { SITE } from "../../../config/site";
import { publishedDistricts } from "../../../lib/locations.js";
import { districtFaqs } from "../../../lib/district-faqs.js";

// Routes come from the publication gate, never from the registry. A district
// with verified geography but no approved evidence record has no URL here.
export function getStaticPaths() {
  return publishedDistricts().map((d) => ({
    params: { state: d.state_slug, district: d.district_slug },
    props: { district: d },
  }));
}
const { district } = Astro.props;
const path = `/locations/${district.state_slug}/${district.district_slug}`;
const faqs = districtFaqs(district, SITE);
const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Coverage", item: `${SITE.url}/locations` },
    { "@type": "ListItem", position: 3, name: district.state_name, item: `${SITE.url}/locations/${district.state_slug}` },
    { "@type": "ListItem", position: 4, name: district.district_name, item: `${SITE.url}${path}` },
  ]},
  // No LocalBusiness here, deliberately: there is no office, phone or geo pin
  // for this district, and inventing one would be a false local-presence claim.
  // The WebPage node comes from the layout; `about` is passed to it below.
  { "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<BaseLayout
  title={`Construction ERP for Contractors in ${district.district_name} | sotyn.ai`}
  description={`Contractor ERP for EPC, MEPF, solar and civil firms in ${district.district_name}: the workflows worth seeing, what onboarding involves, and what it costs.`}
  path={path}
  about={`${SITE.url}/#software`}
  schema={schema}
>
  <DistrictPage district={district} />
</BaseLayout>
