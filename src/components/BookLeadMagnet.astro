---
import { SITE, waLink, telLink } from "../config/site";
import Icon from "./Icon.astro";
const PDF = "/downloads/11-point-project-savings-checklist.pdf";
const { source = "book-checklist" } = Astro.props;
---
<div class="magnet">
  <form class="magnet__form" id="magnetForm" data-source={source} novalidate data-webhook={SITE.leadWebhookUrl} data-wa={SITE.whatsapp} data-pdf={PDF}>
    <div class="magnet__grid">
      <div class="field">
        <label for="mg-name">Name<span aria-hidden="true">*</span></label>
        <input id="mg-name" name="name" type="text" required autocomplete="name" placeholder="Your full name" />
      </div>
      <div class="field">
        <label for="mg-phone">Phone / WhatsApp<span aria-hidden="true">*</span></label>
        <input id="mg-phone" name="phone" type="tel" required autocomplete="tel" placeholder="10-digit mobile" pattern="[0-9+ ]{8,15}" />
      </div>
      <div class="field field--full">
        <label for="mg-email">Work email <span class="opt">(to send you future guides)</span></label>
        <input id="mg-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" />
      </div>
    </div>
    <input type="text" name="website_hp" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
    <button type="submit" class="btn btn--primary btn--lg" id="mg-submit"><Icon name="download" size={20} /> Get the free checklist</button>
    <p class="magnet__note"><Icon name="lock" size={14} /> Instant download. No spam — just practical project guides, occasionally.</p>
    <p class="magnet__status" id="mg-status" role="status" aria-live="polite"></p>
    <div class="magnet__recover" id="mg-recover" hidden>
      <p class="magnet__recover-h">You have the checklist, but we couldn't save your details — so we can't send the follow-up guides yet.</p>
      <div class="magnet__recover-acts">
        <button type="submit" class="btn btn--primary btn--sm">Try again</button>
        <a class="btn btn--ghost btn--sm" id="mg-wa" href={waLink()} target="_blank" rel="noopener">Send details on WhatsApp instead</a>
      </div>
    </div>
  </form>

  <div class="magnet__done" id="magnetDone" hidden>
    <div class="magnet__check" aria-hidden="true"><Icon name="check" size={30} /></div>
    <h3>Your checklist is ready</h3>
    <p class="muted">Thanks! Your download should have started automatically.</p>
    <a class="btn btn--primary" href={PDF} download id="mg-dl">Download the PDF again</a>
    <p class="magnet__note" style="margin-top:14px">Want the full playbook? <a href="https://www.amazon.in/Deadly-Facts-value-project-Bestsellers/dp/8197111332" target="_blank" rel="noopener nofollow">View the book on Amazon →</a></p>
  </div>
</div>

<style>
  .magnet {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: var(--shadow-md);
  }
  .magnet__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .field { display: flex; flex-direction: column; gap: 7px; }
  .field--full { grid-column: 1 / -1; }
  .field label { font-size: .85rem; font-weight: 600; color: var(--ink); }
  .field label .opt { font-weight: 400; color: var(--muted); }
  .field input {
    font-family: inherit; font-size: 1rem; padding: 13px 15px; border: 1.5px solid var(--line);
    border-radius: var(--radius-sm); background: var(--bg); color: var(--ink); width: 100%;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .field input::placeholder { color: #9ca3af; }
  .field input:focus {
    border-color: var(--brand-500);
    outline: none;
    box-shadow: 0 0 0 4px rgba(59,130,246,.1);
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .magnet .btn--lg { width: 100%; }
  .magnet__note { display: flex; align-items: center; gap: 7px; font-size: .8rem; color: var(--muted); margin: 12px 0 0; }
  .magnet__note :global(.ico) { flex: none; }
  .magnet__status { margin: 10px 0 0; font-weight: 600; font-size: .92rem; min-height: 1.1em; }
  .magnet__status[data-state="ok"] { color: var(--brand-700); }
  .magnet__status[data-state="err"] { color: var(--graphite-800); }
  #mg-submit[disabled] { opacity: .6; cursor: progress; }
  .magnet__done { text-align: center; padding: 12px 4px; }
  .magnet__check {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--brand-50); color: var(--brand-600);
    display: grid; place-items: center; margin: 0 auto 12px;
  }
  .magnet__done h3 { margin: 6px 0 4px; }
  .magnet__recover { margin-top: 12px; padding: 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); background: var(--brand-50, #f4f8ff); }
  .magnet__recover-h { margin: 0 0 10px; font-size: .88rem; font-weight: 600; }
  .magnet__recover-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .magnet__recover-acts .btn { flex: 1 1 auto; }
  @media (max-width: 560px) { .magnet__grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { submitLead, waLink, newRequestId, trackAcceptedLead } from "../lib/lead-client.js";

  const form = document.getElementById("magnetForm");
  const statusEl = document.getElementById("mg-status");
  const btn = document.getElementById("mg-submit");
  const done = document.getElementById("magnetDone");
  const recover = document.getElementById("mg-recover");
  const waBtn = document.getElementById("mg-wa");

  if (form) {
    const endpoint = form.dataset.webhook || "";
    const wa = form.dataset.wa;
    const pdf = form.dataset.pdf;
    let requestId = newRequestId();
    let sending = false;

    function triggerDownload() {
      const a = document.createElement("a");
      a.href = pdf;
      a.download = "";
      document.body.appendChild(a);
      a.click();
      a.remove();
      // A download is an interaction, not an enquiry — tracked separately from
      // generate_lead so it can never be counted as a lead.
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "file_download", file_name: "11-point-project-savings-checklist.pdf", lead_page: location.pathname });
      } catch {}
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;
      if (form.website_hp.value) return; // honeypot
      const data = Object.fromEntries(new FormData(form).entries());
      delete data.website_hp;
      if (!data.name || !data.phone) {
        statusEl.dataset.state = "err";
        statusEl.textContent = "Please add your name and phone.";
        return;
      }

      const source = form.dataset.source || "book-checklist";
      sending = true;
      btn.disabled = true;
      recover.hidden = true;
      statusEl.dataset.state = "";
      statusEl.textContent = "Preparing your download…";

      const result = await submitLead(
        endpoint,
        {
          ...data,
          source,
          magnet: "11-point-project-savings-checklist",
          page: location.pathname,
          referrer: document.referrer || "",
          landingSearch: location.search || "",
          submittedAt: new Date().toISOString(),
        },
        { requestId }
      );

      sending = false;
      btn.disabled = false;

      // They get the asset either way — it was promised for the click.
      triggerDownload();

      if (result.accepted) {
        trackAcceptedLead({ source, page: location.pathname, leadId: result.leadId });
        statusEl.textContent = "";
        form.hidden = true;
        done.hidden = false;
        return;
      }

      requestId = newRequestId();
      statusEl.dataset.state = "err";
      statusEl.textContent = "Your download has started.";
      if (waBtn) {
        waBtn.href = waLink(wa, [
          "Free checklist request",
          `Name: ${data.name}`,
          `Phone: ${data.phone}`,
          data.email ? `Email: ${data.email}` : "",
          "Downloaded: 11-Point Project Savings Checklist",
        ]);
      }
      recover.hidden = false;
    });
  }
</script>
